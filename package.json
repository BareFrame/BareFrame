{
  "name": "bareframe",
  "productName": "BareFrame",
  "version": "1.0.13",
  "description": "Bare-Metal Windows Performance & Latency Optimizer for Competitive PC Gamers",
  "main": "src/main.js",
  "author": "BareFrame",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bareframe.optimizer",
    "productName": "BareFrame",
    "copyright": "Copyright © 2026 BareFrame",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico",
      "signtoolOptions": {
        "sign": "./scripts/sign.js"
      }
    },
    "portable": {
      "artifactName": "BareFrame-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BareFrame",
      "artifactName": "BareFrame-Setup.exe"
    }
  }
}
