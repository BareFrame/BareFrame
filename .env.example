# ==============================================================================
# FrameForge Windows Code Signing Environment Variables (copy to .env or CI)
# ==============================================================================

# --- OPTION 1 (Recommended): Microsoft Azure Trusted Signing (~$9.99/mo) ---
# Gives instant Windows SmartScreen trust without buying a $400 hardware token.
AZURE_SIGNING_ENDPOINT=https://eus.codesigning.azure.net/
AZURE_SIGNING_ACCOUNT=frameforge-signing
AZURE_SIGNING_PROFILE=frameforge-public-trust
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional override if Azure.CodeSigning.Dlib.dll is in a custom path:
# AZURE_SIGNING_DLIB=C:\Tools\Azure.CodeSigning.Dlib.dll

# --- OPTION 2: Hardware USB Token (DigiCert / Sectigo / SSL.com EV/OV) ---
# WIN_CERT_SHA1=YOUR_40_CHAR_CERT_THUMBPRINT

# --- OPTION 3: Local PFX Certificate ---
# WIN_PFX_PATH=C:\Certs\frameforge.pfx
# WIN_PFX_PASSWORD=your-password
